# Plantilla. El Secret real NO se versiona (lo ignora **/*secret*.yaml).
# Se crea copiando los valores desde webhook-secret (namespace dev), ver el paso
# "Crear el Secret" del procedimiento, para que ambos valores coincidan.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-provisioning-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: noc-observability-pipeline
    environment: monitoring
type: Opaque
stringData:
  PG_PASSWORD: "CAMBIAR"
  NOC_WEBHOOK_TOKEN: "CAMBIAR"
