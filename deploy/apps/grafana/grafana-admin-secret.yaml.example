# Plantilla SIN valores reales. El Secret real se crea con kubectl (ver README).
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: noc-observability-pipeline
    environment: monitoring
type: Opaque
stringData:
