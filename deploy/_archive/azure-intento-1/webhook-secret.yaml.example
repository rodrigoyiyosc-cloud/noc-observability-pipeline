# k8s/webhook-secret.yaml
#
# Credenciales y config sensible del webhook-service, equivalentes a lo que
# hoy vive en `.env` + `env_file` dentro de docker-compose.yml.
#
# NO commitear este archivo con valores reales. Los placeholders de abajo
# existen solo para documentar las claves esperadas. En AKS, poblar esto vÃ­a
# uno de:
#   - `kubectl create secret generic webhook-service-secrets --from-env-file=.env -n <namespace>`
#   - Azure Key Vault Provider for Secrets Store CSI Driver (recomendado en
#     un cluster corporativo â€” evita tener el secreto en texto plano en git
#     o en el etcd del cluster sin cifrado adicional)
#   - InyecciÃ³n desde GitHub Actions con `kubectl apply` + `--from-literal`
#     usando los mismos secrets de repo que usa ci.yml para ACR.
apiVersion: v1
kind: Secret
metadata:
  name: CAMBIAR
  labels:
    app: CAMBIAR
type: Opaque
stringData:
  # â”€â”€ Auth del webhook (Bearer compartido con el contact point de Grafana) â”€â”€
  NOC_WEBHOOK_TOKEN: CAMBIAR

  # â”€â”€ Credenciales de conexiÃ³n a TimescaleDB (host queda fuera de esta fase; â”€
  # ver restricciÃ³n de alcance en webhook-deployment.yaml) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  PG_PASSWORD: CAMBIAR
  PG_DSN: CAMBIAR

  # â”€â”€ IntegraciÃ³n Jira Cloud â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  JIRA_URL: CAMBIAR
  JIRA_USER: CAMBIAR
  JIRA_API_TOKEN: CAMBIAR
  JIRA_PROJECT_KEY: CAMBIAR
  JIRA_RESOLVE_TRANSITION_NAME: CAMBIAR
  JIRA_ISSUE_TYPE: CAMBIAR

  # â”€â”€ NOC-MAS (LangGraph + Groq) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  GROQ_API_KEY: CAMBIAR
