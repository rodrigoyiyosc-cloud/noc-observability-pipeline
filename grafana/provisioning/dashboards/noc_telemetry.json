{
  "__inputs": [
    {
      "name": "DS_TIMESCALEDB_NOC",
      "label": "TimescaleDB-NOC",
      "description": "",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "NOC Network Telemetry — Pipeline Python → TimescaleDB → Grafana",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "⚡ Critical Events — Last 15 min",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"Critical events (15m)\"\nFROM network_telemetry\nWHERE ts >= NOW() - INTERVAL '15 minutes'\n  AND (severity = 'CRITICAL' OR iface_status = 'DOWN');",
          "refId": "A"
        }
      ],
      "title": "CRITICAL / DOWN Events",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "CRITICAL": { "color": "red",    "index": 0, "text": "CRITICAL" },
                                 "ERROR":    { "color": "orange", "index": 1, "text": "ERROR"    },
                                 "WARN":     { "color": "yellow", "index": 2, "text": "WARN"     },
                                 "INFO":     { "color": "blue",   "index": 3, "text": "INFO"     } },
                    "type": "value" }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "State" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "DOWN": { "color": "red",   "index": 0, "text": "DOWN" },
                                 "UP":   { "color": "green", "index": 1, "text": "UP"   } },
                    "type": "value" }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 1 },
      "id": 4,
      "options": { "footer": { "show": false }, "showHeader": true, "sortBy": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
          "format": "table",
          "rawSql": "SELECT\n  ts                AS \"Time\",\n  hostname          AS \"Device\",\n  severity          AS \"Severity\",\n  message           AS \"Message\",\n  interface         AS \"Interface\",\n  iface_status      AS \"State\",\n  cpu_pct           AS \"CPU %\",\n  latency_ms        AS \"Latency (ms)\",\n  packet_loss_pct   AS \"Loss %\"\nFROM network_telemetry\nWHERE ts >= NOW() - INTERVAL '15 minutes'\n  AND (severity = 'CRITICAL' OR iface_status = 'DOWN')\nORDER BY ts DESC, severity;",
          "refId": "A"
        }
      ],
      "title": "Critical & DOWN Event Log",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "📈 Time Series — Latency & CPU",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*latency.*" },
            "properties": [{ "id": "unit", "value": "ms" }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*cpu.*" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
          "format": "time_series",
          "rawSql": "SELECT\n  time_bucket('$__interval', ts) AS \"time\",\n  hostname,\n  AVG(latency_ms) AS latency_ms\nFROM v_telemetry_ts\nWHERE $__timeFilter(ts)\n  AND hostname IN ($hostname)\nGROUP BY 1, 2\nORDER BY 1;",
          "refId": "Latency"
        },
        {
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
          "format": "time_series",
          "rawSql": "SELECT\n  time_bucket('$__interval', ts) AS \"time\",\n  hostname,\n  AVG(cpu_pct) AS cpu_pct\nFROM v_telemetry_ts\nWHERE $__timeFilter(ts)\n  AND hostname IN ($hostname)\nGROUP BY 1, 2\nORDER BY 1;",
          "refId": "CPU"
        }
      ],
      "title": "Latency (ms) & CPU (%) per device",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 12,
      "title": "🖥️ Device Snapshot",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": null },
                { "color": "yellow", "value": 70   },
                { "color": "red",    "value": 90   }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Latency (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": null },
                { "color": "yellow", "value": 50   },
                { "color": "red",    "value": 200  }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                    "CRITICAL": { "color": "red",    "index": 0 },
                    "ERROR":    { "color": "orange", "index": 1 },
                    "WARN":     { "color": "yellow", "index": 2 },
                    "INFO":     { "color": "blue",   "index": 3 }
                }}
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last iface state" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                    "DOWN": { "color": "red",   "index": 0 },
                    "UP":   { "color": "green", "index": 1 }
                }}
              ]}
            ]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "id": 2,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "CPU %" }]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
          "format": "table",
          "rawSql": "SELECT\n  ts               AS \"Last seen\",\n  hostname         AS \"Device\",\n  severity         AS \"Severity\",\n  cpu_pct          AS \"CPU %\",\n  latency_ms       AS \"Latency (ms)\",\n  packet_loss_pct  AS \"Packet loss %\",\n  iface_status     AS \"Last iface state\"\nFROM v_device_latest\nORDER BY\n  CASE severity\n    WHEN 'CRITICAL' THEN 1\n    WHEN 'ERROR'    THEN 2\n    WHEN 'WARN'     THEN 3\n    ELSE                 4\n  END, hostname;",
          "refId": "A"
        }
      ],
      "title": "Device Current State",
      "type": "table"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["noc", "timescaledb", "network", "telemetry"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
        "definition": "SELECT DISTINCT hostname FROM devices ORDER BY hostname;",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "hostname",
        "options": [],
        "query": "SELECT DISTINCT hostname FROM devices ORDER BY hostname;",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Device"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "NOC — Network Telemetry",
  "uid": "noc-telemetry-v1",
  "version": 1
}
