{
  "__inputs": [],
  "__requires": [],
  "id": null,
  "uid": "noc-postmortem-001",
  "title": "NOC - Postmortem & MTTR",
  "description": "KPIs operativos post-incidente: MTTR general y por dispositivo, conteo de incidentes e historial reciente.",
  "tags": ["noc", "postmortem", "mttr", "timescaledb"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "name": "region",
        "type": "query",
        "label": "Region",
        "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
        "definition": "SELECT DISTINCT region FROM devices ORDER BY region;",
        "query": "SELECT DISTINCT region FROM devices ORDER BY region;",
        "hide": 0,
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "options": [],
        "sort": 1
      },
      {
        "name": "hostname",
        "type": "query",
        "label": "Device",
        "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
        "query": "SELECT DISTINCT hostname FROM devices ORDER BY hostname",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MTTR General",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n    AVG(resolution_seconds) AS \"MTTR (s)\"\nFROM v_incident_mttr\nWHERE\n    $__timeFilter(started_at)\n    AND hostname IN ($hostname)\n    AND region IN ($region);",
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 900 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Incidentes Totales (rango)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n    COUNT(DISTINCT fingerprint) AS \"Total incidents\"\nFROM v_incident_events\nWHERE\n    status = 'firing'\n    AND $__timeFilter(starts_at)\n    AND hostname IN ($hostname)\n    AND region IN ($region);",
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "MTTR por Dispositivo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n    hostname                 AS \"Device\",\n    AVG(resolution_seconds)  AS \"MTTR (s)\"\nFROM v_incident_mttr\nWHERE\n    $__timeFilter(started_at)\n    AND hostname IN ($hostname)\n    AND region IN ($region)\nGROUP BY hostname\nORDER BY 2 DESC;",
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 900 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Conteo de Incidentes por Dispositivo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n    hostname                        AS \"Device\",\n    COUNT(DISTINCT fingerprint)     AS \"Incident count\"\nFROM v_incident_events\nWHERE\n    status = 'firing'\n    AND $__timeFilter(starts_at)\n    AND hostname IN ($hostname)\n    AND region IN ($region)\nGROUP BY hostname\nORDER BY 2 DESC;",
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": { "showLegend": false }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Historial de Incidentes Recientes",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "postgres", "uid": "timescaledb_noc" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n    f.started_at                                        AS \"Started\",\n    f.hostname                                           AS \"Device\",\n    f.region                                              AS \"Region\",\n    f.severity                                            AS \"Severity\",\n    f.alert_name                                           AS \"Alert\",\n    ls.status                                               AS \"Current status\",\n    r.resolved_at                                            AS \"Resolved\",\n    CASE\n        WHEN r.resolved_at IS NOT NULL\n        THEN EXTRACT(EPOCH FROM (r.resolved_at - f.started_at))\n    END                                                        AS \"MTTR (s)\"\nFROM (\n    SELECT fingerprint, hostname, region, severity, alert_name, MIN(starts_at) AS started_at\n    FROM v_incident_events\n    WHERE status = 'firing' AND fingerprint IS NOT NULL\n    GROUP BY fingerprint, hostname, region, severity, alert_name\n) f\nLEFT JOIN (\n    SELECT fingerprint, MIN(received_at) AS resolved_at\n    FROM v_incident_events\n    WHERE status = 'resolved'\n    GROUP BY fingerprint\n) r ON r.fingerprint = f.fingerprint\nLEFT JOIN v_incident_latest_status ls ON ls.fingerprint = f.fingerprint\nWHERE\n    $__timeFilter(f.started_at)\n    AND f.hostname IN ($hostname)\n    AND f.region IN ($region)\nORDER BY f.started_at DESC\nLIMIT 100;",
          "datasource": { "type": "postgres", "uid": "timescaledb_noc" }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "MTTR (s)" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Current status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "firing": { "color": "red", "text": "FIRING" } } },
                  { "type": "value", "options": { "resolved": { "color": "green", "text": "RESOLVED" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "color": "red", "text": "CRITICAL" } } },
                  { "type": "value", "options": { "warning": { "color": "orange", "text": "WARNING" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Started", "desc": true }]
      }
    }
  ]
}